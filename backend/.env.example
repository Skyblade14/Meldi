# Kopieren nach backend/.env und anpassen. Alle Werte optional.

# Whisper-Modell (Begründung: docs/spracherkennung-messung.md)
MELDI_STT_MODEL=large-v3-turbo
MELDI_STT_DEVICE=cpu
MELDI_STT_COMPUTE_TYPE=int8
# 0 = alle Kerne
MELDI_STT_CPU_THREADS=0
MELDI_STT_BEAM_SIZE=5

# Einsatzbetrieb: keine Downloads (Modelle vorher mit `uv run meldi download-model` laden)
MELDI_STT_LOCAL_FILES_ONLY=false

# Einsatzablage: alle Nachrichten mit Aufnahmen und Fotos, ein Ordner pro Einsatz (Default: data/ablage)
# MELDI_ABLAGE_DIR=D:\Meldi\Ablage

# NUR Testphase: Aufnahmen + Erkennung in data/audio/ speichern (Benchmark-Material). Danach löschen!
MELDI_STT_KEEP_AUDIO=false

# Nur für Entwicklung ohne HTTPS auf false setzen
MELDI_COOKIE_SECURE=true
MELDI_SESSION_HOURS=24
